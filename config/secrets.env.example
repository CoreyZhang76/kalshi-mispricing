# Copy to config/secrets.env and fill in. secrets.env is gitignored.
# Get these from kalshi.com -> Account -> API Keys. The private key is shown
# exactly once at creation time and cannot be recovered afterwards.
KALSHI_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=C:/Users/czhang/.kalshi/kalshi_private_key.pem
# "prod" or "demo". Demo is a separate exchange with fake money and thin books.
KALSHI_ENV=prod
